{
  "expo": {
    "name": "NEXUSALPHA",
    "slug": "nexusalpha",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nexusalpha",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0E11"
    },
    "ios": {
      "supportsTablet": false,
      "jsEngine": "jsc"
    },
    "android": {
      "jsEngine": "jsc"
    },
    "web": {
      "favicon": "./assets/images/icon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://nexusalpha88.netlify.app/"
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "eas": {
        "projectId": "0c5484d9-fba8-4334-8b2c-4801518b94c3"
      }
    },
    "owner": "noctivluniv",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/0c5484d9-fba8-4334-8b2c-4801518b94c3"
    }
  }
}
