#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/Users/donyhariyanto/nexus-alpha/node_modules/.pnpm/gmgn-cli@1.5.0/node_modules/gmgn-cli/node_modules:/Users/donyhariyanto/nexus-alpha/node_modules/.pnpm/gmgn-cli@1.5.0/node_modules:/Users/donyhariyanto/nexus-alpha/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/Users/donyhariyanto/nexus-alpha/node_modules/.pnpm/gmgn-cli@1.5.0/node_modules/gmgn-cli/node_modules:/Users/donyhariyanto/nexus-alpha/node_modules/.pnpm/gmgn-cli@1.5.0/node_modules:/Users/donyhariyanto/nexus-alpha/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../gmgn-cli/dist/index.js" "$@"
else
  exec node  "$basedir/../gmgn-cli/dist/index.js" "$@"
fi
